# ---------------------------------------------------------------
# Copy to .env.local for development. NEVER commit real values.
# ---------------------------------------------------------------

# Public site URL, no trailing slash (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser ONLY because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# SERVER-ONLY secret key (service role). Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Contact form spam protection (Cloudflare Turnstile) - requires configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email delivery (optional until a provider is chosen)
CONTACT_NOTIFY_EMAIL=
