diff --git a/tests/integration/stack/nginx.conf b/tests/integration/stack/nginx.conf
new file mode 100644
index 0000000..913deef
--- /dev/null
+++ b/tests/integration/stack/nginx.conf
@@ -0,0 +1,10 @@
+# Test-only gateway that mimics Supabase's API gateway: the Supabase JS client always calls /rest/v1/*,
+# while a bare PostgREST serves from "/". Mounted as /etc/nginx/conf.d/default.conf in docker-compose.yml.
+server {
+  listen 8080;
+  location = /health { return 200 "ok"; }
+  location /rest/v1/ {
+    proxy_pass http://rest:3000/;
+    proxy_set_header Host $host;
+  }
+}
